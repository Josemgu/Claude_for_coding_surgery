<?xml version="1.0" encoding="utf-8" ?>
<cascara:PaginaDeFichas
    x:Class="Fichas.App.Inicio.PaginaDeInicio"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cascara="using:Fichas.App.Cascara"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inicio="using:Fichas.App.Inicio"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <cascara:PaginaDeFichas.Resources>
        <!--
            Los colores salen uno a uno de mockups/mockup-v2-inicio.html, que es el aspecto
            que el dueno aprobo. Se copia la composicion, no el HTML.
        -->

        <x:Double x:Key="AltoDeUnaLista">300</x:Double>
        <x:Double x:Key="AltoDelEquipo">190</x:Double>

        <!--
            Lo que se pulsa es un BOTON, aunque no lo parezca.

            Hasta el 2026-09-05 un renglon era un Border y el clic se cazaba escuchando los
            pulsos de la pagina entera y subiendo por el arbol. Funciona con el raton y
            NO funciona con nada mas: un Border no tiene patron de invocacion, asi que ni
            el teclado, ni un lector de pantalla, ni una comprobacion automatica pueden
            pulsarlo. Un boton con fondo transparente se ve igual, se puede tabular, se
            anuncia como pulsable y se deja medir.

            Y hay una cosa que ademas ARREGLA: un dia sin grupos queda «IsEnabled=False», o
            sea que se ve y se anuncia como no pulsable, que es exactamente el criterio
            C12-6. Con un Border no habia forma de decir eso.
        -->
        <Style x:Key="LoQueSePulsa" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <!--
            Alto de una celda del calendario.

            El mockup pone 74 px porque sus dias de ejemplo traen una o dos pastillas. Con
            la base de 3 000 casos casi todos los dias traen mas de tres, y a 76 px la
            celda cortaba la tercera pastilla Y el renglon «+N mas» —justo el que dice que
            hay mas—, sin ninguna forma de verlo. Es un caso del requisito 1: nada se
            recorta sin forma de verlo.

            La cifra NO es una estimacion. El programa mide el alto que pide el contenido
            de la celda mas llena y lo escribe en su informe. Desde el 2026-09-05 una
            pastilla es un GRUPO y no un documento, asi que la cifra se volvio a medir con
            las pastillas nuevas y va en la entrega.
        -->
        <x:Double x:Key="AltoDeUnDia">150</x:Double>

        <!--
            El renglon de un documento listo para asignar: cuando viaja, su numero y su
            unidad, y cuantas personas van. Fondo transparente porque el contenedor no es
            una ListView: sin fondo, el hueco entre textos no se puede pulsar.
        -->
        <DataTemplate x:Key="RenglonListoPlantilla" x:DataType="inicio:RenglonDeCaso">
          <Button
              AutomationProperties.Name="{x:Bind ParaElLector, Mode=OneTime}"
              Click="AlPulsarUnDocumentoListo"
              Style="{StaticResource LoQueSePulsa}">
            <Grid
                Padding="6,5"
                Background="Transparent"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="{x:Bind inicio:PinturaDeInicio.GrosorDeLaFecha(EsVencido), Mode=OneTime}"
                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeLaFecha(EsVencido), Mode=OneTime}"
                    Text="{x:Bind CuandoViaja, Mode=OneTime}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                        Text="{x:Bind NumeroCaso, Mode=OneTime}" />
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                        Text="{x:Bind DetalleDeLoListo, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{x:Bind inicio:PinturaDeInicio.VerdeMarca, Mode=OneTime}"
                    Text="{x:Bind CuantasPersonasTexto, Mode=OneTime}" />
            </Grid>
          </Button>
        </DataTemplate>

        <!--
            El renglon de una PERSONA con la recomendacion sin confirmar.

            ⛔ Es una persona y no un documento, y ahi esta el cambio entero de esta banda:
            una familia de cinco donde fallo uno es UNA persona (criterio C21-3). Si aqui
            saliera el documento, el dueno no sabria a quien tiene que buscar en el sistema
            de la Iglesia.
        -->
        <DataTemplate x:Key="RenglonDeUnaPersonaConTicketPlantilla" x:DataType="inicio:PersonaConTicket">
          <Button
              AutomationProperties.Name="{x:Bind ParaElLector, Mode=OneTime}"
              Click="AlPulsarUnaPersonaConTicket"
              Style="{StaticResource LoQueSePulsa}">
            <Grid
                Padding="6,5"
                Background="Transparent"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="Bold"
                    Foreground="{x:Bind inicio:PinturaDeInicio.RojoMarca, Mode=OneTime}"
                    Text="{x:Bind CuandoViaja, Mode=OneTime}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                        Text="{x:Bind Nombre, Mode=OneTime}" />
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                        Text="{x:Bind Detalle, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--
                    Aqui iba la palabra ARCHIVADO, que el dueno pidio el 2026-09-03 y quito el
                    2026-09-06: un archivado ya no llega a esta lista, asi que no hay nada que marcar.
                -->
            </Grid>
          </Button>
        </DataTemplate>

        <!--  El renglon de un documento asignado: quien lo lleva y como va.  -->
        <DataTemplate x:Key="RenglonAsignadoPlantilla" x:DataType="inicio:RenglonDeCaso">
          <Button
              AutomationProperties.Name="{x:Bind ParaElLector, Mode=OneTime}"
              Click="AlPulsarUnDocumentoAsignado"
              Style="{StaticResource LoQueSePulsa}">
            <Grid
                Padding="6,5"
                Background="Transparent"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="{x:Bind inicio:PinturaDeInicio.GrosorDeLaFecha(EsVencido), Mode=OneTime}"
                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeLaFecha(EsVencido), Mode=OneTime}"
                    Text="{x:Bind CuandoViaja, Mode=OneTime}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                        Text="{x:Bind NumeroCaso, Mode=OneTime}" />
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                        Text="{x:Bind DetalleDeLoAsignado, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                    Text="{x:Bind CuantasPersonasTexto, Mode=OneTime}" />
            </Grid>
          </Button>
        </DataTemplate>

        <!--  Un renglon del cuadro de cuanto lleva cada companero.  -->
        <DataTemplate x:Key="RenglonDeCompaneroPlantilla" x:DataType="inicio:RenglonDeCompanero">
            <Grid Padding="6,5" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                    Text="{x:Bind Nombre, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    FontSize="12.5"
                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                    Text="{x:Bind CasosTexto, Mode=OneTime}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    FontSize="12.5"
                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                    Text="{x:Bind SinDevolverTexto, Mode=OneTime}" />
            </Grid>
        </DataTemplate>

        <!--  Las iniciales de la cabecera del calendario, con la misma rejilla que los dias.  -->
        <DataTemplate x:Key="InicialDelDiaPlantilla" x:DataType="x:String">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                Text="{x:Bind}" />
        </DataTemplate>

        <!--
            Una celda del calendario. Trae como mucho tres pastillas y el «+N mas»:
            asi el numero de elementos del calendario no crece con los datos (C1-5).

            Desde el 2026-09-05 una pastilla es un GRUPO —una unidad de ese dia— y no un
            documento suelto (C12-2), y la celda entera es pulsable: lleva al grupo de ese
            dia. El nombre para el lector de pantalla lo pone el propio dia, porque una
            celda con tres pastillas diminutas no se puede leer en voz alta de otra forma.
        -->
        <DataTemplate x:Key="DiaDelCalendarioPlantilla" x:DataType="inicio:DiaDelCalendario">
            <Border
                MinHeight="{StaticResource AltoDeUnDia}"
                Padding="4,3"
                AutomationProperties.Name="{x:Bind ParaElLector, Mode=OneTime}"
                Background="{x:Bind inicio:PinturaDeInicio.FondoDelDia(EsDelMes, EnLaVentana), Mode=OneTime}"
                BorderBrush="{x:Bind inicio:PinturaDeInicio.BordeDelDia(EsHoy), Mode=OneTime}"
                BorderThickness="{x:Bind inicio:PinturaDeInicio.GrosorDelDia(EsHoy), Mode=OneTime}">
              <Button
                  AutomationProperties.Name="{x:Bind ParaElLector, Mode=OneTime}"
                  Click="AlPulsarUnDia"
                  IsEnabled="{x:Bind SePuedePulsar, Mode=OneTime}"
                  Style="{StaticResource LoQueSePulsa}">
                <StackPanel>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{x:Bind inicio:PinturaDeInicio.TintaDelDia(EsDelMes), Mode=OneTime}"
                            Text="{x:Bind Numero, Mode=OneTime}" />
                        <!--  La flecha dice, sin depender del color, que ese dia lleva a alguna parte.  -->
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Foreground="{x:Bind inicio:PinturaDeInicio.Apagado, Mode=OneTime}"
                            Text="&#x203a;"
                            Visibility="{x:Bind inicio:PinturaDeInicio.SeVe(SePuedePulsar), Mode=OneTime}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind Pastillas, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="inicio:PastillaDeDia">
                                <Border
                                    Margin="0,2,0,0"
                                    Padding="4,2"
                                    Background="{x:Bind inicio:PinturaDeInicio.FondoDeLaPastilla(CuantasPersonasConfirmadas, CuantasPersonas), Mode=OneTime}"
                                    BorderBrush="{x:Bind inicio:PinturaDeInicio.BordeDeLaPastilla(CuantasPersonasConfirmadas, CuantasPersonas), Mode=OneTime}"
                                    BorderThickness="3,0,0,0">
                                    <StackPanel>
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                                            Text="{x:Bind Titulo, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="9.5"
                                            FontWeight="Bold"
                                            Foreground="{x:Bind inicio:PinturaDeInicio.GrisMarca, Mode=OneTime}"
                                            Text="{x:Bind Etiqueta, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="10"
                        Foreground="{x:Bind inicio:PinturaDeInicio.Apagado, Mode=OneTime}"
                        Text="{x:Bind TextoDeLasQueFaltan, Mode=OneTime}"
                        Visibility="{x:Bind inicio:PinturaDeInicio.SeVe(HayMas), Mode=OneTime}" />
                </StackPanel>
              </Button>
            </Border>
        </DataTemplate>
    </cascara:PaginaDeFichas.Resources>

    <!--
        Toda pantalla va dentro de un ScrollView (ADR-0003 §6.2). En ScrollView no existe
        «Disabled»: no se puede escribir una pantalla que no baje, que es justo el defecto
        que origino el cambio de lenguaje. Y cada lista trae ADEMAS su propio
        desplazamiento con barra visible, porque una lista larga dentro de una pagina que
        baja obliga a recorrer la pagina entera para ver el final de la lista.
 y no herencia del sistema: los colores de esta pantalla son
        los del mockup que aprobo el dueno, que es claro. Con Windows en modo oscuro —como
        esta esta maquina— los controles que NO llevan color puesto a mano cogen los
        pinceles del tema oscuro y salen en blanco sobre fondo claro: medido en la captura
        del 2026-09-04, el boton «Hoy» era ilegible. El dueno pidio el 2026-09-05 poder
        elegir el tema; cuando eso exista, esta linea se quita.
    -->
    <ScrollView
        x:Name="_desplazamientoDeLaPantalla"
        Background="{x:Bind inicio:PinturaDeInicio.Panel, Mode=OneTime}"
        ContentOrientation="Vertical"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">

        <Grid
            MinWidth="{StaticResource AnchoMinimoDeContenido}"
            Margin="{StaticResource MargenDePantalla}"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============================ LA CABECERA ============================  -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            VerticalAlignment="Bottom"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                            Text="Hoy" />
                        <TextBlock
                            x:Name="_hoy"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,2"
                            FontSize="13"
                            Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}" />
                    </StackPanel>
                    <!--  El denominador del C1-1: N en la base, N en pantalla, siempre a la vista.  -->
                    <TextBlock
                        x:Name="_denominador"
                        FontSize="12"
                        Foreground="{x:Bind inicio:PinturaDeInicio.Apagado, Mode=OneTime}" />
                </StackPanel>

                <!--
                    Lo que no esta completo tiene su propia ventana y se entra por aqui.
                    Palabras del dueno el 2026-09-05: «crea una ventana de revisar lo que no
                    está completo, y ponlo por grupo de fechas».
                -->
                <Button
                    x:Name="_verLoIncompleto"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="AlPedirLoIncompleto"
                    Content="Lo que no está completo"
                    FontSize="12.5" />
            </Grid>

            <!--
                ===================== LAS DOS COSAS QUE PIDIO, Y NADA MAS ==================

                Palabras del dueno el 2026-09-05: «Lo unico que quiero ver en Home es lo que
                esta listo para asignar y lo que esta asignado a los agentes».

                Lo que habia antes no se borro del programa: «Personas por viajar», «Con la
                recomendacion completa», «Viajaron sin verificar», «Por verificar antes de
                que salgan» y «Sin fecha de viaje» estan ahora en la ventana de incompletos,
                agrupadas por fecha de viaje, que es donde el pidio verlas.
            -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ······················ LISTO PARA ASIGNAR ······················  -->
                <Border
                    Grid.Column="0"
                    Background="{x:Bind inicio:PinturaDeInicio.Papel, Mode=OneTime}"
                    BorderBrush="{x:Bind inicio:PinturaDeInicio.Linea, Mode=OneTime}"
                    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,7"
                            Background="{x:Bind inicio:PinturaDeInicio.CabeceraVerde, Mode=OneTime}"
                            BorderBrush="{x:Bind inicio:PinturaDeInicio.CabeceraVerdeOscura, Mode=OneTime}"
                            BorderThickness="0,0,0,1">
                            <!--
                                ⛔ El rotulo NO se queda solo: debajo va lo que significa
                                (criterio C17-1). El dueno pidio esta cifra el 2026-09-05
                                —«si el sistema escanea y verifica todos los campos sin mi
                                intervención, debe decir listo para asignar»— y el MISMO dia
                                dijo que «listo» a secas le hacia leer la otra pregunta: «no
                                puede poner los PDF listos para viajar porque no se ha
                                verificado la recomendación en el sistema del obispo».
                            -->
                            <StackPanel Spacing="1">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeCabecera, Mode=OneTime}"
                                    Text="Listo para asignar" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeCabecera, Mode=OneTime}"
                                    Text="el sistema llenó todos los campos"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel
                            Grid.Row="1"
                            Margin="12,8,12,4"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                x:Name="_cuantosListos"
                                VerticalAlignment="Bottom"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.VerdeMarca, Mode=OneTime}" />
                            <TextBlock
                                x:Name="_deQueVanLosListos"
                                Margin="0,0,0,4"
                                VerticalAlignment="Bottom"
                                FontSize="12.5"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--
                            Lista virtualizada y con SU PROPIA barra.

                            El alto va acotado a proposito: un repetidor sin alto dentro de
                            un desplazamiento recibe alto infinito, deja de virtualizar y
                            construye los 3 000 renglones.

                            Y es un ScrollView con un ItemsRepeater dentro, y no una
                            ListView. Medido el 2026-09-04 empujando la rueda de verdad: con
                            ListView, las 12 muescas movieron la PANTALLA 384 px y la lista
                            no se movio ni un pixel, y el evento no llegaba siquiera a la
                            ListView. El ScrollView de la pantalla recoge la rueda en el
                            compositor, antes de que ningun manejador de XAML pueda verla;
                            solo otro ScrollView dentro se la queda.
                        -->
                        <ScrollView
                            x:Name="_listos"
                            Grid.Row="2"
                            MaxHeight="{StaticResource AltoDeUnaLista}"
                            Margin="4,0,4,8"
                            ContentOrientation="Vertical"
                            VerticalScrollBarVisibility="Visible">
                            <ItemsRepeater x:Name="_listosRenglones" ItemTemplate="{StaticResource RenglonListoPlantilla}" />
                        </ScrollView>
                    </Grid>
                </Border>

                <!--  ···················· ASIGNADO A LOS AGENTES ····················  -->
                <Border
                    Grid.Column="1"
                    Background="{x:Bind inicio:PinturaDeInicio.Papel, Mode=OneTime}"
                    BorderBrush="{x:Bind inicio:PinturaDeInicio.Linea, Mode=OneTime}"
                    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,7"
                            Background="{x:Bind inicio:PinturaDeInicio.CabeceraAmbar, Mode=OneTime}"
                            BorderBrush="{x:Bind inicio:PinturaDeInicio.CabeceraAmbarOscura, Mode=OneTime}"
                            BorderThickness="0,0,0,1">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeCabecera, Mode=OneTime}"
                                Text="Asignado a los agentes" />
                        </Border>

                        <StackPanel
                            Grid.Row="1"
                            Margin="12,8,12,4"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                x:Name="_cuantosAsignados"
                                VerticalAlignment="Bottom"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.AmbarMarca, Mode=OneTime}" />
                            <TextBlock
                                x:Name="_deQueVanLosAsignados"
                                Margin="0,0,0,4"
                                VerticalAlignment="Bottom"
                                FontSize="12.5"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollView
                            x:Name="_asignados"
                            Grid.Row="2"
                            MaxHeight="{StaticResource AltoDeUnaLista}"
                            Margin="4,0,4,4"
                            ContentOrientation="Vertical"
                            VerticalScrollBarVisibility="Visible">
                            <ItemsRepeater x:Name="_asignadosRenglones" ItemTemplate="{StaticResource RenglonAsignadoPlantilla}" />
                        </ScrollView>

                        <Border
                            Grid.Row="3"
                            Padding="12,5"
                            Background="{x:Bind inicio:PinturaDeInicio.Panel, Mode=OneTime}"
                            BorderBrush="{x:Bind inicio:PinturaDeInicio.Linea, Mode=OneTime}"
                            BorderThickness="0,1,0,1">
                            <TextBlock
                                FontSize="12.5"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                                Text="Cuánto lleva cada compañero" />
                        </Border>

                        <ScrollView
                            x:Name="_equipo"
                            Grid.Row="4"
                            MaxHeight="{StaticResource AltoDelEquipo}"
                            Margin="4,4,4,8"
                            ContentOrientation="Vertical"
                            VerticalScrollBarVisibility="Visible">
                            <ItemsRepeater x:Name="_equipoRenglones" ItemTemplate="{StaticResource RenglonDeCompaneroPlantilla}" />
                        </ScrollView>
                    </Grid>
                </Border>
            </Grid>

            <!--
                ================= LA RECOMENDACION EN EL SISTEMA DEL OBISPO =================

                ⛔ Es la TERCERA cosa de Inicio y NO toca las dos de arriba. Aquellas hablan
                de nuestros campos; esta habla del sistema de la Iglesia, que el programa no
                ve y que solo una persona puede mirar. Las dos preguntas conviven a proposito
                (ADR-0006 §1.3), y cada una dice de que va.

                Palabras del dueno el 2026-09-05: «En el Home debe decirme: las personas del
                grupo del 17 de septiembre, faltan 3, 4 o 5 personas que la recomendación para
                el templo no está confirmada. Ahí yo puedo verificarlos y ver en el sistema de
                la Iglesia».

                Y no hay ningun aviso que salga solo (C21-5): ni correo, ni sonido, ni
                servicio. El aviso es esta lista, que se ve al abrir.
            -->
            <Border
                Grid.Row="2"
                Background="{x:Bind inicio:PinturaDeInicio.Papel, Mode=OneTime}"
                BorderBrush="{x:Bind inicio:PinturaDeInicio.Linea, Mode=OneTime}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="12,7"
                        Background="{x:Bind inicio:PinturaDeInicio.CabeceraRoja, Mode=OneTime}"
                        BorderBrush="{x:Bind inicio:PinturaDeInicio.CabeceraRojaOscura, Mode=OneTime}"
                        BorderThickness="0,0,0,1">
                        <StackPanel Spacing="1">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeCabecera, Mode=OneTime}"
                                Text="Listo para viajar" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeCabecera, Mode=OneTime}"
                                Text="la recomendación de cada persona, confirmada en el sistema del obispo"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  La frase del grupo que viene, con sus palabras y su denominador.  -->
                    <TextBlock
                        x:Name="_elGrupoQueViene"
                        Grid.Row="1"
                        Margin="12,8,12,2"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                        TextWrapping="Wrap" />

                    <!--  Lo que ya viajo sin confirmar y lo que apremia, en DOS lineas.  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="12,0,12,6"
                        Spacing="1">
                        <TextBlock
                            x:Name="_loVencido"
                            FontSize="12.5"
                            Foreground="{x:Bind inicio:PinturaDeInicio.RojoMarca, Mode=OneTime}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="_loQueApremia"
                            FontSize="12.5"
                            Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--
                        La lista de PERSONAS, virtualizada y con su propia barra, por lo
                        mismo que las otras dos: sin alto acotado el repetidor recibe alto
                        infinito y construye un renglon por dato.
                    -->
                    <ScrollView
                        x:Name="_tickets"
                        Grid.Row="3"
                        MaxHeight="{StaticResource AltoDeUnaLista}"
                        Margin="4,0,4,8"
                        ContentOrientation="Vertical"
                        VerticalScrollBarVisibility="Visible">
                        <ItemsRepeater x:Name="_ticketsRenglones" ItemTemplate="{StaticResource RenglonDeUnaPersonaConTicketPlantilla}" />
                    </ScrollView>
                </Grid>
            </Border>

            <!--
                ============================ EL CALENDARIO ============================

                Ya no es adorno. Palabras del dueno el 2026-09-05: «El calendario no puede
                estar de lujo. Cuando el calendario ponga un grupo de personas en una fecha,
                yo debo poder darle clic y ver solamente al grupo de personas que viajará en
                esa fecha, con su PDF».
            -->
            <Border
                Grid.Row="3"
                Background="{x:Bind inicio:PinturaDeInicio.Papel, Mode=OneTime}"
                BorderBrush="{x:Bind inicio:PinturaDeInicio.Linea, Mode=OneTime}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="12,5"
                        Background="{x:Bind inicio:PinturaDeInicio.Panel, Mode=OneTime}"
                        BorderBrush="{x:Bind inicio:PinturaDeInicio.Linea, Mode=OneTime}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="_tituloDelMes"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                                Text="Pulse un día para abrir el grupo que viaja ese día" />
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    AutomationProperties.Name="Mes anterior"
                                    Click="AlPedirElMesAnterior"
                                    Content="&#x2039;"
                                    FontSize="13" />
                                <Button
                                    Click="AlPedirElMesDeHoy"
                                    Content="Hoy"
                                    FontSize="12" />
                                <Button
                                    AutomationProperties.Name="Mes siguiente"
                                    Click="AlPedirElMesSiguiente"
                                    Content="&#x203a;"
                                    FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsRepeater
                        x:Name="_inicialesDeLosDias"
                        Grid.Row="1"
                        Margin="8,6,8,2"
                        ItemTemplate="{StaticResource InicialDelDiaPlantilla}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MaximumRowsOrColumns="7"
                                MinColumnSpacing="2"
                                MinItemWidth="52"
                                Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <ItemsRepeater
                        x:Name="_mes"
                        Grid.Row="2"
                        Margin="8,0,8,6"
                        ItemTemplate="{StaticResource DiaDelCalendarioPlantilla}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MaximumRowsOrColumns="7"
                                MinColumnSpacing="2"
                                MinItemHeight="{StaticResource AltoDeUnDia}"
                                MinItemWidth="52"
                                MinRowSpacing="2"
                                Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <TextBlock
                        Grid.Row="3"
                        Margin="8,0,8,10"
                        FontSize="11.5"
                        Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                        Text="cada pastilla es un grupo: una unidad de ese día  ·  la cifra son PERSONAS con la recomendación confirmada  ·  rojo: falta alguna por confirmar  ·  verde: todas confirmadas  ·  lo archivado no sale aquí: se ve en Revisar" />
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</cascara:PaginaDeFichas>
