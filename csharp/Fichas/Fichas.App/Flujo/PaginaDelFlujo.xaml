<?xml version="1.0" encoding="utf-8" ?>
<cascara:PaginaDeFichas
    x:Class="Fichas.App.Flujo.PaginaDelFlujo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cascara="using:Fichas.App.Cascara"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inicio="using:Fichas.App.Inicio"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        ============================ LA PESTANA DEL FLUJO ============================

        Las TRES listas que estaban en Inicio, juntas y con entrada propia en el menu.

        Palabras del dueno el 2026-09-07, repetidas el 2026-09-09 porque no se habia hecho:
        «Listo para asignar debe ser una ventana, no debe estar en el home del sistema.
        Tampoco asignar a los agentes, eso debe estar en otra ventana. Y listo para viajar
        igual: LOS TRES EN UNA MISMA PESTANA».

        ⛔ Los colores, las plantillas y los altos vienen TAL CUAL de Inicio, sin retocar ni
        uno: esto es una mudanza, no un rediseno. Cada decision de aspecto que se lee aqui
        tiene su motivo escrito en Inicio/PaginaDeInicio.xaml y sigue siendo el mismo.

        ⛔ Y lee por el MISMO LectorDelInicio que Inicio. No se escribio un lector nuevo a
        proposito: dos lectores con la misma pregunta acaban contestando distinto, y el cuadro
        de cifras de Inicio y estas listas tienen que decir siempre lo mismo.
    -->
    <cascara:PaginaDeFichas.Resources>

        <x:Double x:Key="AltoDeUnaLista">300</x:Double>
        <x:Double x:Key="AltoDelEquipo">190</x:Double>

        <!--
            Lo que se pulsa es un BOTON, aunque no lo parezca. El motivo entero esta en
            Inicio/PaginaDeInicio.xaml: un Border no tiene patron de invocacion, asi que ni
            el teclado, ni un lector de pantalla, ni una comprobacion automatica pueden
            pulsarlo.
        -->
        <Style x:Key="LoQueSePulsa" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <!--  El renglon de un documento listo para asignar.  -->
        <DataTemplate x:Key="RenglonListoPlantilla" x:DataType="inicio:RenglonDeCaso">
          <Button
              AutomationProperties.Name="{x:Bind ParaElLector, Mode=OneTime}"
              Click="AlPulsarUnDocumentoListo"
              Style="{StaticResource LoQueSePulsa}">
            <Grid
                Padding="6,5"
                Background="Transparent"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="{x:Bind inicio:PinturaDeInicio.GrosorDeLaFecha(EsVencido), Mode=OneTime}"
                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeLaFecha(EsVencido), Mode=OneTime}"
                    Text="{x:Bind CuandoViaja, Mode=OneTime}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                        Text="{x:Bind NumeroCaso, Mode=OneTime}" />
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                        Text="{x:Bind DetalleDeLoListo, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{x:Bind inicio:PinturaDeInicio.VerdeMarca, Mode=OneTime}"
                    Text="{x:Bind CuantasPersonasTexto, Mode=OneTime}" />
            </Grid>
          </Button>
        </DataTemplate>

        <!--  El renglon de un documento asignado: quien lo lleva y como va.  -->
        <DataTemplate x:Key="RenglonAsignadoPlantilla" x:DataType="inicio:RenglonDeCaso">
          <Button
              AutomationProperties.Name="{x:Bind ParaElLector, Mode=OneTime}"
              Click="AlPulsarUnDocumentoAsignado"
              Style="{StaticResource LoQueSePulsa}">
            <Grid
                Padding="6,5"
                Background="Transparent"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="{x:Bind inicio:PinturaDeInicio.GrosorDeLaFecha(EsVencido), Mode=OneTime}"
                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeLaFecha(EsVencido), Mode=OneTime}"
                    Text="{x:Bind CuandoViaja, Mode=OneTime}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                        Text="{x:Bind NumeroCaso, Mode=OneTime}" />
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                        Text="{x:Bind DetalleDeLoAsignado, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                    Text="{x:Bind CuantasPersonasTexto, Mode=OneTime}" />
            </Grid>
          </Button>
        </DataTemplate>

        <!--  Un renglon del cuadro de cuanto lleva cada companero.  -->
        <DataTemplate x:Key="RenglonDeCompaneroPlantilla" x:DataType="inicio:RenglonDeCompanero">
            <Grid Padding="6,5" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                    Text="{x:Bind Nombre, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    FontSize="12.5"
                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                    Text="{x:Bind CasosTexto, Mode=OneTime}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    FontSize="12.5"
                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                    Text="{x:Bind SinDevolverTexto, Mode=OneTime}" />
            </Grid>
        </DataTemplate>

        <!--
            El renglon de una PERSONA con la recomendacion sin confirmar.

            ⛔ Es una persona y no un documento: una familia de cinco donde fallo uno es UNA
            persona. Si aqui saliera el documento, el dueno no sabria a quien buscar en el
            sistema de la Iglesia.
        -->
        <DataTemplate x:Key="RenglonDeUnaPersonaConTicketPlantilla" x:DataType="inicio:PersonaConTicket">
          <Button
              AutomationProperties.Name="{x:Bind ParaElLector, Mode=OneTime}"
              Click="AlPulsarUnaPersonaConTicket"
              Style="{StaticResource LoQueSePulsa}">
            <Grid
                Padding="6,5"
                Background="Transparent"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="Bold"
                    Foreground="{x:Bind inicio:PinturaDeInicio.RojoMarca, Mode=OneTime}"
                    Text="{x:Bind CuandoViaja, Mode=OneTime}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                        Text="{x:Bind Nombre, Mode=OneTime}" />
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                        Text="{x:Bind Detalle, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
          </Button>
        </DataTemplate>
    </cascara:PaginaDeFichas.Resources>

    <ScrollView
        x:Name="_desplazamientoDeLaPantalla"
        Background="{x:Bind inicio:PinturaDeInicio.Panel, Mode=OneTime}"
        ContentOrientation="Vertical"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">

        <Grid
            MinWidth="{StaticResource AnchoMinimoDeContenido}"
            Margin="{StaticResource MargenDePantalla}"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============================ LA CABECERA ============================  -->
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                    Text="Flujo de trabajo" />
                <!--  El denominador: sin el, ninguna de las tres cifras se puede comprobar.  -->
                <TextBlock
                    x:Name="_denominador"
                    FontSize="12"
                    Foreground="{x:Bind inicio:PinturaDeInicio.Apagado, Mode=OneTime}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ······················ LISTO PARA ASIGNAR ······················  -->
                <Border
                    Grid.Column="0"
                    Background="{x:Bind inicio:PinturaDeInicio.Papel, Mode=OneTime}"
                    BorderBrush="{x:Bind inicio:PinturaDeInicio.Linea, Mode=OneTime}"
                    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,7"
                            Background="{x:Bind inicio:PinturaDeInicio.CabeceraVerde, Mode=OneTime}"
                            BorderBrush="{x:Bind inicio:PinturaDeInicio.CabeceraVerdeOscura, Mode=OneTime}"
                            BorderThickness="0,0,0,1">
                            <!--
                                ⛔ El rotulo NO se queda solo: debajo va lo que significa. «Listo»
                                a secas le hacia leer la otra pregunta —«no puede poner los PDF
                                listos para viajar porque no se ha verificado la recomendacion en
                                el sistema del obispo»—, y las dos estan ahora en esta pantalla,
                                una al lado de la otra, asi que decir cual es cual importa mas.
                            -->
                            <StackPanel Spacing="1">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeCabecera, Mode=OneTime}"
                                    Text="Listo para asignar" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeCabecera, Mode=OneTime}"
                                    Text="el sistema llenó todos los campos"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel
                            Grid.Row="1"
                            Margin="12,8,12,4"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                x:Name="_cuantosListos"
                                VerticalAlignment="Bottom"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.VerdeMarca, Mode=OneTime}" />
                            <TextBlock
                                x:Name="_deQueVanLosListos"
                                Margin="0,0,0,4"
                                VerticalAlignment="Bottom"
                                FontSize="12.5"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--
                            Lista virtualizada y con SU PROPIA barra. El alto va acotado a
                            proposito: un repetidor sin alto dentro de un desplazamiento recibe
                            alto infinito, deja de virtualizar y construye los 3 000 renglones.
                        -->
                        <ScrollView
                            x:Name="_listos"
                            Grid.Row="2"
                            MaxHeight="{StaticResource AltoDeUnaLista}"
                            Margin="4,0,4,8"
                            ContentOrientation="Vertical"
                            VerticalScrollBarVisibility="Visible">
                            <ItemsRepeater x:Name="_listosRenglones" ItemTemplate="{StaticResource RenglonListoPlantilla}" />
                        </ScrollView>
                    </Grid>
                </Border>

                <!--  ···················· ASIGNADO A LOS AGENTES ····················  -->
                <Border
                    Grid.Column="1"
                    Background="{x:Bind inicio:PinturaDeInicio.Papel, Mode=OneTime}"
                    BorderBrush="{x:Bind inicio:PinturaDeInicio.Linea, Mode=OneTime}"
                    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,7"
                            Background="{x:Bind inicio:PinturaDeInicio.CabeceraAmbar, Mode=OneTime}"
                            BorderBrush="{x:Bind inicio:PinturaDeInicio.CabeceraAmbarOscura, Mode=OneTime}"
                            BorderThickness="0,0,0,1">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeCabecera, Mode=OneTime}"
                                Text="Asignado a los agentes" />
                        </Border>

                        <StackPanel
                            Grid.Row="1"
                            Margin="12,8,12,4"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                x:Name="_cuantosAsignados"
                                VerticalAlignment="Bottom"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.AmbarMarca, Mode=OneTime}" />
                            <TextBlock
                                x:Name="_deQueVanLosAsignados"
                                Margin="0,0,0,4"
                                VerticalAlignment="Bottom"
                                FontSize="12.5"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollView
                            x:Name="_asignados"
                            Grid.Row="2"
                            MaxHeight="{StaticResource AltoDeUnaLista}"
                            Margin="4,0,4,4"
                            ContentOrientation="Vertical"
                            VerticalScrollBarVisibility="Visible">
                            <ItemsRepeater x:Name="_asignadosRenglones" ItemTemplate="{StaticResource RenglonAsignadoPlantilla}" />
                        </ScrollView>

                        <Border
                            Grid.Row="3"
                            Padding="12,5"
                            Background="{x:Bind inicio:PinturaDeInicio.Panel, Mode=OneTime}"
                            BorderBrush="{x:Bind inicio:PinturaDeInicio.Linea, Mode=OneTime}"
                            BorderThickness="0,1,0,1">
                            <TextBlock
                                FontSize="12.5"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                                Text="Cuánto lleva cada compañero" />
                        </Border>

                        <ScrollView
                            x:Name="_equipo"
                            Grid.Row="4"
                            MaxHeight="{StaticResource AltoDelEquipo}"
                            Margin="4,4,4,8"
                            ContentOrientation="Vertical"
                            VerticalScrollBarVisibility="Visible">
                            <ItemsRepeater x:Name="_equipoRenglones" ItemTemplate="{StaticResource RenglonDeCompaneroPlantilla}" />
                        </ScrollView>
                    </Grid>
                </Border>
            </Grid>

            <!--
                ================= LA RECOMENDACION EN EL SISTEMA DEL OBISPO =================

                ⛔ Es la TERCERA lista y NO toca las dos de arriba. Aquellas hablan de nuestros
                campos; esta habla del sistema de la Iglesia, que el programa no ve y que solo
                una persona puede mirar. Las dos preguntas conviven a proposito (ADR-0006 §1.3),
                y cada una dice de que va.

                Y no hay ningun aviso que salga solo (C21-5): ni correo, ni sonido, ni servicio.
                El aviso es esta lista, que se ve al abrir la pestana.
            -->
            <Border
                Grid.Row="2"
                Background="{x:Bind inicio:PinturaDeInicio.Papel, Mode=OneTime}"
                BorderBrush="{x:Bind inicio:PinturaDeInicio.Linea, Mode=OneTime}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="12,7"
                        Background="{x:Bind inicio:PinturaDeInicio.CabeceraRoja, Mode=OneTime}"
                        BorderBrush="{x:Bind inicio:PinturaDeInicio.CabeceraRojaOscura, Mode=OneTime}"
                        BorderThickness="0,0,0,1">
                        <StackPanel Spacing="1">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeCabecera, Mode=OneTime}"
                                Text="Listo para viajar" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{x:Bind inicio:PinturaDeInicio.TintaDeCabecera, Mode=OneTime}"
                                Text="pulse una persona para contestar sus seis preguntas"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  La frase del grupo que viene, con sus palabras y su denominador.  -->
                    <TextBlock
                        x:Name="_elGrupoQueViene"
                        Grid.Row="1"
                        Margin="12,8,12,2"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind inicio:PinturaDeInicio.Tinta, Mode=OneTime}"
                        TextWrapping="Wrap" />

                    <!--  Lo que ya viajo sin confirmar y lo que apremia, en DOS lineas.  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="12,0,12,6"
                        Spacing="1">
                        <TextBlock
                            x:Name="_loVencido"
                            FontSize="12.5"
                            Foreground="{x:Bind inicio:PinturaDeInicio.RojoMarca, Mode=OneTime}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="_loQueApremia"
                            FontSize="12.5"
                            Foreground="{x:Bind inicio:PinturaDeInicio.TintaSuave, Mode=OneTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollView
                        x:Name="_tickets"
                        Grid.Row="3"
                        MaxHeight="{StaticResource AltoDeUnaLista}"
                        Margin="4,0,4,8"
                        ContentOrientation="Vertical"
                        VerticalScrollBarVisibility="Visible">
                        <ItemsRepeater x:Name="_ticketsRenglones" ItemTemplate="{StaticResource RenglonDeUnaPersonaConTicketPlantilla}" />
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</cascara:PaginaDeFichas>
