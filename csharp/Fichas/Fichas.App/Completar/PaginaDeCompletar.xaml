<?xml version="1.0" encoding="utf-8" ?>
<cascara:PaginaDeFichas
    x:Class="Fichas.App.Completar.PaginaDeCompletar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cascara="using:Fichas.App.Cascara"
    xmlns:completar="using:Fichas.App.Completar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        La pestaña octava, pedida por el dueño el 2026-09-06 con estas palabras: «debe haber
        una tab solo para esto: completar información de documentos que faltan».

        ⛔ NO es una copia de la ventana de incompletos de Inicio, y la diferencia es la
        razón de ser de esta pantalla: aquélla es una lista para MIRAR, agrupada por fecha;
        ésta es una COLA para TRABAJAR. Por eso aquí no hay cabeceras de grupo, hay un
        número de orden por renglón y hay un botón que arranca el encadenado.

        Los colores salen de ThemeResource y no de una paleta propia: el dueño eligió el
        tema el 2026-09-05 y así la pantalla le hace caso sin que este archivo se entere.
    -->
    <cascara:PaginaDeFichas.Resources>

        <x:Double x:Key="AltoDeLaCola">560</x:Double>

        <!--
            Lo que se pulsa es un BOTÓN, aunque no lo parezca. El motivo entero está escrito
            en Inicio/PaginaDeInicio.xaml, donde nació: un Border se puede pulsar con el
            ratón y con nada más —ni teclado, ni lector de pantalla, ni una comprobación
            automática—, porque no tiene patrón de invocación.
        -->
        <Style x:Key="LoQueSePulsa" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <DataTemplate x:Key="PuestoDeLaColaPlantilla" x:DataType="completar:PuestoEnLaCola">
            <Button
                AutomationProperties.Name="{x:Bind ParaElLector, Mode=OneTime}"
                Click="AlPulsarUnDocumento"
                Style="{StaticResource LoQueSePulsa}">
                <Grid Padding="12,7" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  El número de orden: sin él, «el siguiente» no se puede comprobar.  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind NumeroDeOrden, Mode=OneTime}" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind CuandoViaja, Mode=OneTime}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Text="{x:Bind NumeroCaso, Mode=OneTime}" />
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind LoQueLeFalta, Mode=OneTime}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </cascara:PaginaDeFichas.Resources>

    <ScrollView
        ContentOrientation="Vertical"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">

        <Grid
            MinWidth="{StaticResource AnchoMinimoDeContenido}"
            Margin="{StaticResource MargenDePantalla}"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Completar información" />
                    <TextBlock
                        x:Name="_denominador"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="_deQueVa"
                        MaxWidth="620"
                        HorizontalAlignment="Left"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    x:Name="_botonDeEmpezar"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Empezar la cola por el documento que viaja antes"
                    Click="AlPulsarEmpezar"
                    Style="{ThemeResource AccentButtonStyle}" />
            </Grid>

            <Border
                Grid.Row="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="12,7"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="La cola · pulse un documento para entrar por él" />
                    </Border>

                    <!--
                        Cuando no queda nada se DICE, y se dice también lo que eso no
                        significa. Una lista vacía sin explicación fue justo lo que el dueño
                        llamó «confuso» el 2026-09-05.
                    -->
                    <TextBlock
                        x:Name="_noQuedaNada"
                        Grid.Row="1"
                        Margin="12,12"
                        MaxWidth="620"
                        HorizontalAlignment="Left"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <ScrollView
                        Grid.Row="2"
                        MaxHeight="{StaticResource AltoDeLaCola}"
                        Margin="4,4,4,8"
                        ContentOrientation="Vertical"
                        VerticalScrollBarVisibility="Visible">
                        <ItemsRepeater x:Name="_renglones" ItemTemplate="{StaticResource PuestoDeLaColaPlantilla}" />
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</cascara:PaginaDeFichas>
